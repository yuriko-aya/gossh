server:
  address: 0.0.0.0
  port: 8088

security:
  fernet_key: REPLACE_WITH_YOUR_OWN_KEY
  # Generate with: python3 generate_url.py --generate-key
  # Or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  token_ttl: 24h  # Access token lifetime (e.g. 1h, 24h, 168h)

rate_limit:
  connect_per_minute: 10   # POST /connect
  ws_per_minute: 20        # WebSocket /ws upgrades
  presign_per_minute: 30   # GET /presign

s3:
  region: us-east-1
  bucket: your-bucket-name
  access_key_id: YOUR_AWS_ACCESS_KEY_ID
  secret_access_key: YOUR_AWS_SECRET_ACCESS_KEY

# Environment variable overrides (take precedence over config.yaml):
#   FERNET_KEY, S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
#   GOSSH_CONFIG  — path to config file (default: config.yaml)
